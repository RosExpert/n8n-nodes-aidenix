{
	"compilerOptions": {
		"strict": true,
		"module": "node16",
		"moduleResolution": "node16",
		"target": "es2019",
		"lib": ["es2019", "es2020"],
		"removeComments": true,
		"useUnknownInCatchVariables": false,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"strictNullChecks": true,
		"preserveConstEnums": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"incremental": true,
		"tsBuildInfoFile": "./.tsbuildinfo",
		"declaration": true,
		"sourceMap": false,
		"skipLibCheck": true,
		"outDir": "./dist/"
	},
	"include": [
		"credentials/**/*",
		"nodes/**/*",
		"nodes/**/*.json",
		"index.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"**/__tests__/**",
		"**/*.test.ts"
	]
}
