{
	"name": "n8n-nodes-aidenix",
	"version": "0.1.11",
	"description": "Aidenix Business Fit node for n8n — evaluate ICP fit and generate personalized outreach for a LinkedIn slug or email.",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"aidenix",
		"business-fit",
		"icp",
		"sales",
		"outreach",
		"lead-qualification"
	],
	"license": "MIT",
	"homepage": "https://aidenix.com",
	"author": {
		"name": "Aidenix",
		"email": "info@aidenix.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RosExpert/n8n-nodes-aidenix.git"
	},
	"bugs": {
		"url": "https://github.com/RosExpert/n8n-nodes-aidenix/issues"
	},
	"engines": {
		"node": ">=18.10"
	},
	"main": "dist/index.js",
	"files": [
		"dist",
		"docs"
	],
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"format": "prettier --write \"nodes/**/*.ts\" \"credentials/**/*.ts\"",
		"lint": "n8n-node lint",
		"lintfix": "n8n-node lint --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/AidenixApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Aidenix/Aidenix.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.32.1",
		"@types/jest": "^29.5.14",
		"@types/node": "^20.19.41",
		"eslint": "9.29.0",
		"jest": "^29.7.0",
		"n8n-workflow": "2.16.0",
		"prettier": "^3.3.2",
		"release-it": "^19.2.4",
		"ts-jest": "^29.4.11",
		"typescript": "^5.5.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
